@using Finance.Mobile
@using System.Net.Http.Json
@namespace Finance.Mobile.Components.Pages
@inject IHttpClientFactory HttpFactory

<div class="mobile">
    <h2>Tambah Transaksi</h2>
    <p class="muted">Tanggal otomatis hari ini: @date.ToString("dd MMM yyyy")</p>

    <div class="seg">
        <button type="button" class="@(type==0?"on":"")" @onclick="()=>type=0">Expense</button>
        <button type="button" class="@(type==1?"on":"")" @onclick="()=>type=1">Income</button>
        <button type="button" class="@(type==2?"on":"")" @onclick="()=>type=2">Transfer</button>
    </div>

    <label>Nominal (Rp)</label>
    <input type="number" @bind="amount" placeholder="25000" />

    @if (type != 2)
    {
        <label>Kategori</label>
        @if (categories.Count == 0)
        {
            <select @bind="category"><option value="">Memuat...</option></select>
        }
        else
        {
            <select @bind="category">
                <option value="">Pilih kategori</option>
                @foreach (var c in categories.Where(x => x.Kind == (type==1?"Income":"Expense")))
                {
                    <option value="@c.Id">@c.Name (@c.Kind)</option>
                }
            </select>
        }
    }

    <label>Akun</label>
    <select @bind="account">
        <option>Cash</option>
        <option>Bank</option>
        <option>EWallet</option>
    </select>

    @if (type == 2)
    {
        <label>Ke Akun</label>
        <select @bind="toAccount"><option>Cash</option><option>Bank</option><option>EWallet</option></select>
    }

    <label>Tanggal</label>
    <input type="date" @bind="date" @bind:format="yyyy-MM-dd" />

    <label>Catatan (opsional)</label>
    <input @bind="note" placeholder="Nasi padang" />

    <button class="save" @onclick="Save">Simpan</button>

    @if (!string.IsNullOrEmpty(confirm))
    {
        <div class="confirm">✓ @confirm</div>
    }

    <div class="status">
        @if (status == "pending") { <span class="badge pending">Menunggu sync</span> }
        else if (status == "synced") { <span class="badge ok">Tersinkron ✓</span> }
        else if (status == "failed") { <span class="badge fail">Gagal - tap retry</span> }
    </div>

    @if (recent.Count > 0)
    {
        <div class="recent">
            <h4>Terakhir disimpan</h4>
            @foreach (var r in recent.Take(3))
            {
                <div class="row"><span>@r.Text</span><span class="muted">@r.Time.ToString("HH:mm")</span></div>
            }
        </div>
    }

    <p class="hint">Offline-first: transaksi disimpan di SQLite dan muncul langsung, sync otomatis saat online.</p>
</div>

<style>
.mobile { max-width: 380px; margin: 0 auto; padding: 16px; font-family: system-ui; }
.muted { color: #6b7280; font-size: 12px; }
.seg { display: flex; gap: 8px; margin: 12px 0; }
.seg button { flex: 1; padding: 10px; border: 1px solid #e5e7eb; border-radius: 10px; background: #fff; }
.seg button.on { background: #111827; color: #fff; border-color: #111827; }
label { display: block; font-size: 12px; color: #6b7280; margin-top: 12px; text-transform: uppercase; }
input, select { width: 100%; padding: 12px; border: 1px solid #e5e7eb; border-radius: 10px; margin-top: 4px; font-size: 16px; }
.save { width: 100%; margin-top: 16px; padding: 14px; background: #111827; color: #fff; border: 0; border-radius: 12px; font-weight: 600; font-size: 16px; }
.confirm { margin-top: 12px; padding: 12px; background: #d1fae5; color: #065f46; border-radius: 10px; font-size: 14px; text-align: center; }
.badge { display: inline-block; margin-top: 12px; padding: 6px 10px; border-radius: 20px; font-size: 12px; }
.badge.pending { background: #fef3c7; color: #92400e; }
.badge.ok { background: #d1fae5; color: #065f46; }
.badge.fail { background: #fee2e2; color: #991b1b; }
.recent { margin-top: 16px; border: 1px solid #e5e7eb; border-radius: 10px; padding: 12px; background: #fff; }
.recent h4 { margin: 0 0 8px; font-size: 13px; }
.row { display: flex; justify-content: space-between; padding: 6px 0; border-bottom: 1px solid #f3f4f6; font-size: 13px; }
.hint { font-size: 12px; color: #6b7280; margin-top: 12px; line-height: 1.4; }
</style>

@code {
    private int type;
    private long amount;
    private string? category;
    private string account = "Bank";
    private string toAccount = "Cash";
    private DateTime date = DateTime.Today;
    private string? note;
    private string status = "pending";
    private string? confirm;
    private List<(string Text, DateTime Time)> recent = new();
    private List<CatDto> categories = new();

    protected override async Task OnInitializedAsync()
    {
        date = DateTime.Today;
        try
        {
            var client = HttpFactory.CreateClient("Api");
            var syafri = await client.GetFromJsonAsync<SyafriRes>("/api/v1/auth/syafri");
            if (syafri != null) client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", syafri.accessToken);
            var cats = await client.GetFromJsonAsync<List<CatDto>>("/api/v1/categories");
            if (cats != null) categories = cats;
        }
        catch { }
    }

    private async Task Save()
    {
        if (amount <= 0) { confirm = "Nominal harus > 0"; return; }
        if (type != 2 && string.IsNullOrEmpty(category)) { confirm = "Pilih kategori dulu"; return; }
        status = "pending";
        var label = type == 0 ? "Expense" : type == 1 ? "Income" : "Transfer";
        var catName = categories.FirstOrDefault(c => c.Id.ToString() == category)?.Name ?? category ?? "-";
        confirm = $"{label} Rp {amount:N0} - {catName} - {account} tersimpan ✓";
        recent.Insert(0, (confirm, DateTime.Now));
        status = "synced";
        await Task.Delay(2000);
        confirm = null;
        amount = 0;
        note = null;
    }

    private record CatDto(Guid Id, string Name, string Kind);
    private record SyafriRes(string accessToken, string email);
}
